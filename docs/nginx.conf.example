# REFERENCE ONLY. Requires approved existing host/TLS configuration.
# Inside the canonical HTTPS server block. Replace root with immutable release path.
root /srv/company-site/current;
index index.html;
location = /app-ads.txt { default_type text/plain; try_files /app-ads.txt =404; }
location = /robots.txt { default_type text/plain; try_files /robots.txt =404; }
location / { try_files $uri $uri/ =404; }
error_page 404 /404.html;
add_header X-Content-Type-Options nosniff always;
add_header Referrer-Policy strict-origin-when-cross-origin always;
add_header X-Frame-Options DENY always;
# HTTPS redirect and apex/www redirect belong in separately approved server blocks.
